const TelegramBotModule = require('node-telegram-bot-api');
const TelegramBot = TelegramBotModule.default || TelegramBotModule;
const WebSocket = require('ws');
const fs = require('fs');
const path = require('path');
const http = require('http'); // Tích hợp HTTP Server cho Railway

// ==========================================
// ⚙️ CẤU HÌNH HỆ THỐNG
// ==========================================
const WS_PORT = process.env.PORT || 8080;
const currentToken = process.env.BOT_TOKEN || '8689114890:AAFBFM0rNtZWpOtAovIPHPVQTJVp0odU1DQ'; 
let bot = null;

const ADMIN_ID = '6138197737'; 
const CHANNEL_ID = '-100xxxxxxxxx'; 

const DB_FILE = path.join(__dirname, 'database.json');
let users = {};
let masterWebSocket = null;

const DEFAULT_LINKED_ACCOUNTS = { 
    SC88: [], C168: [], CM88: [], F8BET: [], QQ88: [], "78WIN": [] 
};

// ==========================================
// 🗄️ QUẢN LÝ DATABASE
// ==========================================
function loadDatabase() {
    try {
        if (fs.existsSync(DB_FILE)) {
            const data = fs.readFileSync(DB_FILE, 'utf8');
            users = JSON.parse(data);
            console.log(`✅ Đã tải dữ liệu của ${Object.keys(users).length} khách hàng.`);
        } else {
            users = {};
        }
    } catch (err) {
        console.error('❌ Lỗi đọc database:', err);
        users = {}; 
    }
}

// ==========================================
// 🤖 KHỞI TẠO BOT TELEGRAM (ANTI-CRASH)
// ==========================================
function startBot(token) {
    try {
        bot = new TelegramBot(token, { polling: true });
        
        // BỘ LỌC CHỐNG SẬP (Quan trọng nhất): Ngăn Node.js sập khi xung đột Python
        bot.on("polling_error", (err) => {
            console.log("[⚠️ CẢNH BÁO TELEGRAM]:", err.message);
            console.log("👉 Lỗi này thường do bạn đang chạy song song file Python và Node.js. Server vẫn sống, không bị sập!");
        });

        console.log('🤖 Bot Telegram (Server) đã khởi động!');
    } catch (e) {
        console.error("❌ Lỗi khởi động bot:", e);
    }
}

// ==========================================
// 🌐 KHỞI TẠO HTTP SERVER & WEBSOCKET
// ==========================================
// 1. Tạo HTTP Server để báo cáo với Railway là App vẫn sống
const server = http.createServer((req, res) => {
    res.writeHead(200, { 'Content-Type': 'text/plain; charset=utf-8' });
    res.end('🟢 Master System Server của Sếp Hendy Đang Hoạt Động Rất Mượt!\n');
});

// 2. Gắn WebSocket lên HTTP Server
const wss = new WebSocket.Server({ server });

wss.on('connection', (ws) => {
    console.log('[+] Một Tab Worker / Client vừa kết nối WebSocket!');
    masterWebSocket = ws;

    ws.on('message', (message) => {
        try {
            const data = JSON.parse(message.toString());
            console.log('[WS] Nhận lệnh:', data.action);
        } catch (e) {}
    });

    ws.on('close', () => {
        console.log('[-] Client đã ngắt kết nối WebSocket.');
        if (masterWebSocket === ws) masterWebSocket = null;
    });
});

// ==========================================
// 🚀 RUN SERVER
// ==========================================
loadDatabase();
startBot(currentToken);

server.listen(WS_PORT, () => {
    console.log(`🚀🚀 HỆ THỐNG ĐÃ RUN TRÊN PORT ${WS_PORT} 🚀🚀`);
});
